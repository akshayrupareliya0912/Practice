using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace prac
{
    internal class Airline_Ticket_Booking_and_Check_in_System
    {
        public class Flight
        {
            public string FlightNumber { get; set; }
            public string Destination { get; set; }
            public int Capacity { get; set; }

            public Flight(string flightNumber, string destination, int capacity)
            {
                FlightNumber = flightNumber;
                Destination = destination;
                Capacity = capacity;
            }

            public override string ToString() => $"{FlightNumber} to {Destination}";
        }
        public class Passenger
        {
            public string Name { get; set; }
            public LinkedList<string> TravelHistory { get; private set; } = new LinkedList<string>();
            public SortedSet<string> VisitedDestinations { get; private set; } = new SortedSet<string>();

            public Passenger(string name)
            {
                Name = name;
            }

            public void AddTrip(string flightInfo, string destination)
            {
                TravelHistory.AddLast(flightInfo);
                VisitedDestinations.Add(destination);
            }

            public void ShowTravelHistory()
            {
                Console.WriteLine($" Travel History for {Name}:");
                foreach (var trip in TravelHistory)
                    Console.WriteLine($"- {trip}");
            }

            public void ShowVisitedDestinations()
            {
                Console.WriteLine($" Unique Destinations for {Name}: {string.Join(", ", VisitedDestinations)}");
            }
        }
        public class AirlineSystem
        {
            public List<Flight> AllFlights = new List<Flight>();
            public SortedList<string, Flight> FlightsSorted = new SortedList<string, Flight>();
            public Dictionary<string, List<Passenger>> Bookings = new Dictionary<string, List<Passenger>>();
            public Dictionary<string, Queue<Passenger>> StandByList = new Dictionary<string, Queue<Passenger>>();
            public Stack<(string flightNo, Passenger passenger)> BookingHistory = new Stack<(string, Passenger)>();

            public void AddFlight(string number, string destination, int capacity)
            {
                var flight = new Flight(number, destination, capacity);
                AllFlights.Add(flight);
                FlightsSorted[number] = flight;
                Bookings[number] = new List<Passenger>();
                StandByList[number] = new Queue<Passenger>();

                Console.WriteLine($" Flight added: {flight}");
            }

            public void BookTicket(string flightNo, Passenger passenger)
            {
                if (!Bookings.ContainsKey(flightNo))
                {
                    Console.WriteLine( "Flight does not exist.");
                    return;
                }

                var bookedList = Bookings[flightNo];
                var flight = FlightsSorted[flightNo];

                if (bookedList.Count < flight.Capacity)
                {
                    bookedList.Add(passenger);
                    BookingHistory.Push((flightNo, passenger));
                    Console.WriteLine($" {passenger.Name} booked {flight}");
                }
                else
                {
                    StandByList[flightNo].Enqueue(passenger);
                    Console.WriteLine($" Flight full. {passenger.Name} added to standby for {flight}");
                }
            }

            public void CancelBooking(string flightNo, string passengerName)
            {
                if (Bookings.TryGetValue(flightNo, out var bookedList))
                {
                    var passenger = bookedList.Find(p => p.Name == passengerName);
                    if (passenger != null)
                    {
                        bookedList.Remove(passenger);
                        Console.WriteLine($" Booking cancelled for {passengerName} on flight {flightNo}");

                        // Move from standby to booked if available
                        if (StandByList[flightNo].Count > 0)
                        {
                            var standbyPassenger = StandByList[flightNo].Dequeue();
                            Bookings[flightNo].Add(standbyPassenger);
                            Console.WriteLine($" {standbyPassenger.Name} moved from standby to booked on {flightNo}");
                        }
                    }
                    else Console.WriteLine(" Passenger not found.");
                }
            }

            public void CheckIn(string flightNo, string passengerName)
            {
                var flight = FlightsSorted[flightNo];
                var passenger = Bookings[flightNo].Find(p => p.Name == passengerName);

                if (passenger != null)
                {
                    passenger.AddTrip($"{flightNo} to {flight.Destination}", flight.Destination);
                    Console.WriteLine($" {passengerName} checked in to {flight}");
                }
                else
                {
                    Console.WriteLine(" Passenger not booked.");
                }
            }

            public void UndoLastBooking()
            {
                if (BookingHistory.Count > 0)
                {
                    var (flightNo, passenger) = BookingHistory.Pop();
                    Bookings[flightNo].Remove(passenger);
                    Console.WriteLine($" Undo booking: {passenger.Name} removed from {flightNo}");
                }
                else
                {
                    Console.WriteLine(" No bookings to undo.");
                }
            }

            public void ShowFlights()
            {
                Console.WriteLine("\n Available Flights:");
                foreach (var f in FlightsSorted.Values)
                    Console.WriteLine($"- {f}");
            }

            public void ShowBookings(string flightNo)
            {
                Console.WriteLine($"Bookings for Flight {flightNo}:");
                if (Bookings.TryGetValue(flightNo, out var passengers))
                {
                    foreach (var p in passengers)
                        Console.WriteLine($"- {p.Name}");
                }
            }

            public void ShowStandBy(string flightNo)
            {
                Console.WriteLine($" Stand-by List for Flight {flightNo}:");
                foreach (var p in StandByList[flightNo])
                    Console.WriteLine($"- {p.Name}");
            }
        }
        public static void Main(string[] args)
        {
            AirlineSystem airline = new AirlineSystem();

            // Add flights
            airline.AddFlight("AA101", "New York", 2);
            airline.AddFlight("BB202", "Los Angeles", 3);

            // Create passengers
            Passenger alice = new Passenger("Alice");
            Passenger bob = new Passenger("Bob");
            Passenger charlie = new Passenger("Charlie");

            // Book tickets
            airline.BookTicket("AA101", alice);
            airline.BookTicket("AA101", bob);
            airline.BookTicket("AA101", charlie); // Should go to standby

            // Check in
            airline.CheckIn("AA101", "Alice");
            airline.CheckIn("AA101", "Bob");

            // Show flight details
            airline.ShowFlights();
            airline.ShowBookings("AA101");
            airline.ShowStandBy("AA101");

            // Undo last booking
            airline.UndoLastBooking();
            airline.ShowBookings("AA101");

            // Show travel history and unique destinations
            alice.ShowTravelHistory();
            alice.ShowVisitedDestinations();
        }
    }
}
